// ============================================================================
// Hard 3-process FSM pattern (verilog-generator / Erie style).
// Use explicit state_current/state_next registers and ST_* localparams.
// Strictly three independent blocks:
//   P1 combinational next-state  (blocking '=' inside always @(*))
//   P2 sequential state register (non-blocking '<=')
//   P3 independent output/task processing
// Rules: never 'assign state_next = ...'; close every if/else-if chain with an
// explicit final else; add a default: begin ... end branch in the case; keep a
// pure leading comment above each ST_*: begin and default: begin branch.
//
// INSERTION POINT (aligns 1:1 with module_skeleton.vinc — no new signals are
// declared by this fragment, it only DRIVES the skeleton's declarations):
//   P1 + P2 -> paste into the skeleton's "state-machine region";
//   P3      -> paste into the skeleton's "output processing region"
//              (replace the skeleton's own P3: both drive done_o/valid_o, so
//              they must never coexist).
// Signal names follow the skeleton exactly: i_start, i_clk, i_rstn,
// flag_busy, cnt_phase, done_o, valid_o, reg_acc, rdata_o, i_wdata.
// ============================================================================

// ---- P1: combinational next-state (blocking assignments) ------------------
always @(*) begin
    state_next = state_current;
    case (state_current)
        // IDLE state transition branch
        ST_IDLE: begin
            if (i_start && !flag_busy) begin
                state_next = ST_ACTIVE;
            end else begin
                state_next = ST_IDLE;
            end
        end
        // ACTIVE state transition branch
        ST_ACTIVE: begin
            if (cnt_phase == {C_COUNT_WIDTH{1'b0}}) begin
                state_next = ST_DONE;
            end else begin
                state_next = ST_ACTIVE;
            end
        end
        // DONE state transition branch
        ST_DONE: begin
            state_next = ST_IDLE;
        end
        // Default state transition branch
        default: begin
            state_next = ST_IDLE;
        end
    endcase
end

// ---- P2: sequential state register (non-blocking) -------------------------
always @(posedge i_clk or negedge i_rstn) begin
    if (!i_rstn) begin
        state_current <= ST_IDLE;
    end else begin
        state_current <= state_next;
    end
end

// ---- P3: independent output/task processing -------------------------------
always @(posedge i_clk or negedge i_rstn) begin
    if (!i_rstn) begin
        flag_busy <= 1'b0;
        done_o    <= 1'b0;
        valid_o   <= 1'b0;
    end else begin
        case (state_current)
            // IDLE state task branch
            ST_IDLE: begin
                flag_busy <= 1'b0;
                done_o    <= 1'b0;
                valid_o   <= 1'b0;
            end
            // ACTIVE state task branch
            ST_ACTIVE: begin
                flag_busy <= 1'b1;
                reg_acc   <= reg_acc + i_wdata;
            end
            // DONE state task branch
            ST_DONE: begin
                flag_busy <= 1'b0;
                done_o    <= 1'b1;
                valid_o   <= 1'b1;
                rdata_o   <= reg_acc;
            end
            // Default state task branch
            default: begin
                done_o    <= 1'b0;
                valid_o   <= 1'b0;
            end
        endcase
    end
end
